# Required: Path to SQLite database file
DATABASE_PATH=./data/jobhq.db

# Optional: Server port (default: 3000)
# PORT=3000

# Optional: Set to 'production' for production builds
# NODE_ENV=production

# Feature flags (set to 'false' to disable)
# ENABLE_CRAWLER=true
# ENABLE_CHINESE_AFFINITY=true
# NEXT_PUBLIC_ENABLE_CRAWLER=true
