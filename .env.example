# Legacy database path (only used for first-user data migration)
DATABASE_PATH=./data/jobhq.db

# Optional: Auth database path (default: ./data/auth.db)
# AUTH_DB_PATH=./data/auth.db

# Optional: Server port (default: 3000)
# PORT=3000

# Optional: Set to 'production' for production builds
# NODE_ENV=production

# Optional: Restrict extension CORS to specific origins (comma-separated)
# EXTENSION_ALLOWED_ORIGINS=chrome-extension://your-extension-id

# Feature flags (set to 'false' to disable)
# ENABLE_CRAWLER=true
# ENABLE_CHINESE_AFFINITY=true
# NEXT_PUBLIC_ENABLE_CRAWLER=true
